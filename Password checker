password = input("Enter your password: ")

length = len(password)

if 8 <= length <= 15:
    print("Password length is valid.")
else:
    print("Password too short or too long. Please try again.")

# Python implementation above
# Pseudocode below

START
    INPUT password
    SET length = length of password

    IF length is between 8 and 15
        OUTPUT "Password length is valid."
    ELSE
        OUTPUT "Password too short or too long."
    END IF
END
